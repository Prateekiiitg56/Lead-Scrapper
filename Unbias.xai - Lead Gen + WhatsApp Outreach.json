      {
        "parameters": {
          "jsCode": "// All prepped leads from this run (single aggregated item)\nconst preppedLeads = $('Aggregate Prepped Leads').first().json.prepped_leads || [];\n\n// Every row currently in the Leads sheet (this node's own input)\nconst contactedRows = $input.all();\nconst contactedPhones = new Set(\n  contactedRows\n    .map(item => (item.json.phone || '').toString().trim())\n    .filter(p => p.length > 0)\n);\n\n// Keep only leads that have a phone and are NOT already in the sheet\nconst newLeads = preppedLeads.filter(lead => {\n  const phone = (lead.lead_phone || '').toString().trim();\n  return phone.length > 0 && !contactedPhones.has(phone);\n});\n\nreturn newLeads.map(lead => ({ json: lead }));"
        },
        "id": "09f1c3c1-deb6-413c-8748-79ff32cfa5eb",
        "name": "Filter New Leads",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          848,
          160
        ]
      },
      {
        "parameters": {
          "jsCode": "const body = $('Webhook - Send Message').item.json.body;\n\nconst templateName = body.template_name || 'first_outreach';\n\nconst parameters = templateName === 'website_automation_pitch_v2'\n  ? [\n      { type: 'text', text: String(body.name || 'there') },\n      { type: 'text', text: String(body.website || 'your website') }\n    ]\n  : [\n      { type: 'text', text: String(body.name || 'there') }\n    ];\n\nconst template_object = {\n  name: templateName,\n  language: { code: 'en' },\n  components: [\n    { type: 'body', parameters }\n  ]\n};\n\nreturn [{\n  json: {\n    ...$input.item.json,\n    template_object\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
