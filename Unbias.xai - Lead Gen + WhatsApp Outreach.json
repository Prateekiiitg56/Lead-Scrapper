        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "WTiUWTnguvHq2SFe",
            "name": "Google Sheets account"
          }
        },
        "notes": "No filter set -> returns every row in the Leads sheet, which we then count by month in the next node."
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\nconst now = new Date();\nconst y = now.getFullYear();\nconst m = now.getMonth();\nlet sentThisMonth = 0;\nconst totalLogged = items.length;\nfor (const item of items) {\n  const d = item.json.date_contacted;\n  if (!d) continue;\n  const dt = new Date(d);\n  if (dt.getFullYear() === y && dt.getMonth() === m && item.json.status === 'sent') {\n    sentThisMonth++;\n  }\n}\nreturn [{ json: { sent_this_month: sentThisMonth, total_logged: totalLogged } }];"
        },
        "id": "2d99c7b5-0b2e-449f-93ae-cd4e68e1b352",
        "name": "Count This Month",
