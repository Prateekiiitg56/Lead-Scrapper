            },
            {
              "id": "wp2",
              "name": "email_body",
              "type": "string",
              "value": "={{`Hi ${$json.business_name || 'there'},\n\nI came across your business${$json.website ? ' at ' + $json.website : ''} and noticed there might be a great opportunity to grow your online presence.\n\nWe build modern, high-converting websites and AI-powered automations specifically for businesses like yours${$json.address ? ' in ' + $json.address : ''}.\n\nHere's what we typically help with:\n• Professional website design that converts visitors into customers\n• Automated lead capture & follow-up systems\n• AI chatbots that handle customer inquiries 24/7\n\nWould you be open to a quick 10-minute call this week to see if we could help?\n\nBest regards,\nUnbias.xai Team`}}"
            },
