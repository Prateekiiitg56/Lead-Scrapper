      "id": "a4d943f7-4fc6-4f3e-8579-9be89490fb09",
      "name": "Route: Message vs Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        672,
        224
      ],
      "notes": "True: inbound message → save + AI classify. False: status update → update existing conversation record."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_PROJECT_ID.supabase.co/rest/v1/leads?on_conflict=phone",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{$json.phone}}\",\n  \"business_name\": \"{{$json.contact_name || 'Unknown Business'}}\",\n  \"status\": \"REPLIED\",\n  \"last_reply_at\": \"{{new Date(parseInt($json.timestamp) * 1000).toISOString()}}\"\n}",
        "options": {}
      },
      "id": "701aa2ff-5727-4dfa-8296-aa29744a01bb",
      "name": "Upsert Lead (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        112
      ],
      "notes": "Upserts lead by phone number and marks status as REPLIED."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_PROJECT_ID.supabase.co/rest/v1/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": \"{{$node['Upsert Lead (Supabase)'].json[0]?.id || $node['Upsert Lead (Supabase)'].json.id}}\",\n  \"direction\": \"INBOUND\",\n  \"message\": \"{{$node['Parse Webhook Payload'].json.text}}\",\n  \"message_type\": \"{{$node['Parse Webhook Payload'].json.message_type}}\",\n  \"status\": \"delivered\",\n  \"wamid\": \"{{$node['Parse Webhook Payload'].json.wamid}}\",\n  \"timestamp\": \"{{new Date(parseInt($node['Parse Webhook Payload'].json.timestamp) * 1000).toISOString()}}\"\n}",
        "options": {}
      },
      "id": "8ad893f0-9ff5-4208-8f1d-be8ee74de165",
      "name": "Save Conversation (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        112
      ],
      "notes": "Saves the inbound message to conversations table in Supabase."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are an AI sales assistant classifier for a business outreach CRM. Analyze customer replies and return structured JSON. Respond ONLY with valid JSON containing: intent (pricing|info|interested|not_interested|complaint|greeting|other), sentiment (positive|neutral|negative), priority (high|medium|low), summary (one sentence), next_action (send_pricing|schedule_call|follow_up|close_lead|escalate|none).\\n\\nCustomer reply: {{$node['Parse Webhook Payload'].json.text}}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "b34ab92c-a8f0-467a-8956-700eaf31467b",
      "name": "AI Classify (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        112
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Gemini API"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Calls Google Gemini 1.5 Flash to classify the inbound message."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://YOUR_SUPABASE_PROJECT_ID.supabase.co/rest/v1/leads?id=eq.{{$node['Upsert Lead (Supabase)'].json[0]?.id || $node['Upsert Lead (Supabase)'].json.id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_ANON_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ai_summary\": \"{{JSON.parse($json.candidates?.[0]?.content?.parts?.[0]?.text || '{}').summary || ''}}\",\n  \"ai_intent\": \"{{JSON.parse($json.candidates?.[0]?.content?.parts?.[0]?.text || '{}').intent || ''}}\",\n  \"ai_sentiment\": \"{{JSON.parse($json.candidates?.[0]?.content?.parts?.[0]?.text || '{}').sentiment || ''}}\",\n  \"interest_score\": {{JSON.parse($json.candidates?.[0]?.content?.parts?.[0]?.text || '{}').sentiment === 'positive' ? 75 : JSON.parse($json.candidates?.[0]?.content?.parts?.[0]?.text || '{}').sentiment === 'neutral' ? 50 : 25}}\n}",
        "options": {}
      },
      "id": "60927b10-5c60-4d2e-b378-1eebd6b7ac20",
