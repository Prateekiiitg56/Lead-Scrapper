      "id": "0224c959-b238-4fb6-8803-5a48bda61a11",
      "name": "WhatsApp Webhook (GET Verification)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "unbias-wa-inbound-get",
      "notes": "Handles Meta GET verification challenge when clicking 'Verify and save' in Meta Portal."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "unbias-wa-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "be61cdc9-53d9-4986-b5b4-947329d8f90c",
      "name": "WhatsApp Webhook (POST Messages)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        208
      ],
      "webhookId": "unbias-wa-inbound-post",
      "notes": "Receives inbound WhatsApp customer messages and delivery status updates."
    },
    {
      "parameters": {
        "jsCode": "// Parse Meta WhatsApp Cloud API webhook payload\nconst body = $json.body || {};\nconst query = $json.query || {};\n\n// ── GET: Meta verification challenge ──\nif (query['hub.mode'] === 'subscribe' || query['hub.challenge']) {\n  return [{ json: { _verification: true, challenge: query['hub.challenge'] } }];\n}\n\n// ── POST: Parse webhook payload ──\nconst entry = (body.entry || [])[0];\nconst change = (entry?.changes || [])[0];\nconst value = change?.value || {};\n\n// 1. Handle inbound customer messages FIRST\nconst messages = value.messages || [];\nif (messages.length > 0) {\n  const msg = messages[0];\n  const contact = (value.contacts || [])[0];\n  const rawPhone = String(msg.from || '').replace(/^\\+/, '');\n  const formattedPhone = '+' + rawPhone;\n  return [{ json: {\n    _type: 'inbound_message',\n    wamid: msg.id,\n    phone: formattedPhone,\n    raw_phone: rawPhone,\n    contact_name: contact?.profile?.name || '',\n    message_type: msg.type,\n    text: msg.text?.body || msg.button?.text || msg.interactive?.button_reply?.title || 'Media message',\n    media_id: msg[msg.type]?.id || null,\n    media_mime: msg[msg.type]?.mime_type || null,\n    timestamp: msg.timestamp || Math.floor(Date.now() / 1000)\n  }}];\n}\n\n// 2. Handle status updates (sent, delivered, read, failed)\nif (value.statuses && value.statuses.length > 0) {\n  const status = value.statuses[0];\n  return [{ json: {\n    _type: 'status_update',\n    wamid: status.id,\n    status: status.status,\n    phone: '+' + String(status.recipient_id || '').replace(/^\\+/, ''),\n    timestamp: status.timestamp,\n    errors: status.errors || null\n  }}];\n}\n\nreturn [{ json: { _type: 'no_message' } }];"
      },
      "id": "a3661779-ed03-442d-86e4-69b76e3cb7b2",
      "name": "Parse Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ],
      "notes": "Prioritizes inbound customer messages, formats phone numbers cleanly, and extracts text content."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
