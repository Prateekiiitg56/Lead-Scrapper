# ── Frontend (Vite) ──────────────────────────────────────────────
# Everything prefixed VITE_ is bundled into public JavaScript.
# Never put secrets or n8n webhook URLs here: the browser reaches n8n only
# through the `n8n-proxy` Edge Function.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# UI-only outreach gating (hides WhatsApp actions and AI drafting for other accounts). Unset = nobody.
# Real enforcement is AUTHORIZED_ADMIN_EMAILS on the Edge Functions (see README).
VITE_ADMIN_EMAIL=your-admin-email@example.com
VITE_AUTHORIZED_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ── Server-side secrets (Supabase Edge Functions) ────────────────
# Set with the Supabase CLI, NOT in this file:
#   supabase secrets set META_ACCESS_TOKEN=... META_PHONE_NUMBER_ID=... GEMINI_API_KEY=...
#   supabase secrets set AUTHORIZED_ADMIN_EMAILS=admin1@example.com,admin2@example.com   (required; unset = nobody can send)
#
# n8n-proxy — webhook URLs plus the shared secret the n8n Webhook nodes check (Header Auth, X-Webhook-Secret):
#   supabase secrets set N8N_WEBHOOK_SECRET=<long random string>
#   supabase secrets set N8N_SEARCH_URL=https://your-n8n/webhook/unbias-lead-search \
#     N8N_SEND_URL=https://your-n8n/webhook/unbias-send-message \
#     N8N_JOBS_URL=https://your-n8n/webhook/unbias-job-search \
#     N8N_PEOPLE_URL=https://your-n8n/webhook/unbias-find-people \
#     N8N_USAGE_URL=https://your-n8n/webhook/unbias-api-usage \
#     N8N_LEAD_USAGE_URL=https://your-n8n/webhook/unbias-lead-api-usage
#
# gmail — same OAuth client as Supabase Auth → Google provider, plus a key that encrypts stored refresh tokens:
#   supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... GMAIL_TOKEN_KEY=<long random string>
