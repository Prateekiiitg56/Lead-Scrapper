# ── Frontend (Vite) ──────────────────────────────────────────────
# Everything prefixed VITE_ is bundled into public JavaScript.
# Never put secrets (Meta tokens, Gemini keys, service-role keys) here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# n8n webhook URLs
VITE_N8N_SEARCH_URL=https://your-n8n/webhook/unbias-lead-search
VITE_N8N_SEND_URL=https://your-n8n/webhook/unbias-send-message
VITE_N8N_STATS_URL=https://your-n8n/webhook/unbias-lead-stats
VITE_N8N_EMAIL_URL=https://your-n8n/webhook/unbias-send-email
# Job Signals: job board search and decision-maker lookup
VITE_N8N_JOBS_URL=https://launch-barterer-carmaker.ngrok-free.dev/webhook/unbias-job-search
VITE_N8N_PEOPLE_URL=https://launch-barterer-carmaker.ngrok-free.dev/webhook/unbias-find-people
# Today's third-party API calls (Adzuna, SerpApi, ...), shown by the gauge icon in the header
VITE_N8N_USAGE_URL=https://your-n8n/webhook/unbias-api-usage
# Today's Google Places calls (business search), from the Lead Gen workflow
VITE_N8N_LEAD_USAGE_URL=https://your-n8n/webhook/unbias-lead-api-usage

# UI-only outreach gating (hides WhatsApp actions for other accounts). Unset = nobody can send.
# Real enforcement is AUTHORIZED_ADMIN_EMAILS on the Edge Functions (see README).
VITE_ADMIN_EMAIL=your-admin-email@example.com
VITE_AUTHORIZED_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ── Server-side secrets (Supabase Edge Functions) ────────────────
# Set with the Supabase CLI, NOT in this file:
#   supabase secrets set META_ACCESS_TOKEN=... META_PHONE_NUMBER_ID=... GEMINI_API_KEY=...
#   supabase secrets set AUTHORIZED_ADMIN_EMAILS=admin1@example.com,admin2@example.com   (required; unset = nobody can send)
